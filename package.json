{
  "name": "video-highlights-spike",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,worker,cv -c blue,magenta,green \"next dev\" \"tsx scripts/worker.ts\" \"bash scripts/dev-cv-worker.sh\"",
    "dev:web": "next dev",
    "dev:worker": "tsx scripts/worker.ts",
    "dev:cv": "bash scripts/dev-cv-worker.sh",
    "dev:infra": "docker compose up -d",
    "db:migrate": "bash scripts/db-migrate.sh",
    "build": "next build",
    "start": "next start",
    "start:worker": "tsx scripts/worker.ts",
    "lint": "eslint",
    "smoke:test": "MOCK_AI=true tsx scripts/smoke-test.ts",
    "worker": "tsx scripts/worker.ts",
    "eval": "tsx scripts/evals/run.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.922.0",
    "@aws-sdk/s3-request-presigner": "^3.922.0",
    "@google/genai": "^2.0.0",
    "@opentelemetry/api": "^1.9.0",
    "bullmq": "^5.63.0",
    "drizzle-orm": "^0.44.7",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "ioredis": "^5.8.1",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "openai": "^6.37.0",
    "p-limit": "^7.2.0",
    "postgres": "^3.4.7",
    "prom-client": "^15.1.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.6",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
