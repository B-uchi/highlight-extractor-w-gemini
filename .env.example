OPENAI_API_KEY=sk-proj-xxx
# Whisper uploads can stall on short SDK timeouts — default below is 10 minutes per request (ms)
OPENAI_HTTP_TIMEOUT_MS=600000
GEMINI_API_KEY=AIzaSyxxx
# Single-request timeout for file upload + Gemini API calls (default 180000 ms). Bump on slow VPN / large chunks.
GEMINI_HTTP_TIMEOUT_MS=180000
GEMINI_CONCURRENCY=4
WHISPER_CONCURRENCY=4

USE_QUEUE=true
REDIS_URL=redis://localhost:6379
JOB_QUEUE_NAME=video-highlights-jobs
WORKER_CONCURRENCY=2
USE_DATABASE_JOBS=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/video_highlights
STORAGE_MODE=local
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BASE_PUBLIC_URL=
ENABLE_CV_WORKER=true
CV_WORKER_URL=http://localhost:8000
MAX_JOB_TOTAL_TOKENS=800000
# Max clips after ranking (conversation UI can override per chat). Use 0 for unlimited (heavy).
MAX_HIGHLIGHTS_FINAL=15
# When true, skip FFmpeg audio extraction + Whisper; ranking uses video + empty transcript cues.
SKIP_TRANSCRIPTION=false
# Durable media root on disk for uploaded inputs + final clips (default ./storage relative to cwd).
DATA_DIR=storage