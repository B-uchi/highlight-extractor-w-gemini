PORT=3001

SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# R2_PRESIGN_EXPIRES_SEC=3600

GEMINI_API_KEY=
# GEMINI_HTTP_TIMEOUT_MS=720000
# GEMINI_CHUNK_DURATION_SEC=581
# GEMINI_ANALYSIS_PARALLELISM=3
# GEMINI_VIDEO_SLOWDOWN=2
# GEMINI_ANALYSIS_FPS=3
# GEMINI_MIN_CONFIDENCE=0.80

# POLL_INTERVAL_MS=30000

# ── Analysis mode ──────────────────────────────────────────────────────────────
# "gemini" (default baseline) or "proposer_verifier" (Qwen on Modal proposes, Gemini verifies)
# ANALYSIS_MODE=gemini

# ── Modal (proposer) ───────────────────────────────────────────────────────────
# Get from https://modal.com/settings/tokens; the modal SDK reads these from env.
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
# QWEN_MODAL_APP=video-highlight-proposer
# QWEN_MODAL_FUNCTION=propose_clips
# QWEN_FPS=8
# QWEN_MAX_PIXELS=147456            # ≈512×288 → ~42 tok/frame (measured via [QWEN-TUNE])
# QWEN_CHUNK_SEC=60                 # ~1 min: recall-safe + small enough to batch several
# QWEN_MAX_MODEL_LEN=40960
# QWEN_BATCH_SIZE=4                 # chunks per Modal call, run concurrently via vLLM batching
# QWEN_PROPOSAL_PARALLELISM=2       # concurrent Modal calls = warm A100s (each billed all job)

# ── Gemini verifier (proposer_verifier mode) ───────────────────────────────────
# VERIFY_MODEL=gemini-3.1-pro-preview
# VERIFY_FPS=6
# VERIFY_PARALLELISM=4             # keep well under the 1000 RPM limit
# VERIFY_MIN_CONFIDENCE=0.6
# VERIFY_PRE_PAD=2.5
# VERIFY_POST_PAD=2.5
